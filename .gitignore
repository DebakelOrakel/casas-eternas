# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.vite/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
casas
casas-eternas

# The server's own stores (world.storage.dir.path / artifacts.storage.dir.path):
# a world is irreplaceable but belongs to whoever ran the server, and an
# artifact is recomputable — neither belongs in the repository.
data/*

# The golden harness's opt-in refactor guard (layer 4). Machine-local by
# nature — Math results can move between V8 versions — and it exists only for
# the length of one refactor, so it is recorded and deleted, never shared.
# golden.json, the permanent metric baseline, IS committed.
client/scripts/golden-hashes.json

# Editor directories and files
.claude/*
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.key
*.crt
*.ca
.htpasswd
client/scripts/amplify-hashes.json
client/scripts/mesh-hashes.json

# The generated documentation site and its bundled generator:
client/docs-dist/
client/scripts/.docsite.mjs

# The job worker bundled for Node. Built by `make worker` (and by the
# Dockerfile itself), so a tracked copy is only ever stale.
job-worker.mjs
