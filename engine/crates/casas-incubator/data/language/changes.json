{
  "about": "Templates of sound changes. A daughter language or a dialect takes some of them, in an order, with a date. Each 'text' becomes the i18n key language.change.<id> later; the ids are stable. See README.md for the notation.",
  "sources": {
    "campbell": "Campbell, L. 2013. Historical Linguistics: An Introduction. 3rd ed. Edinburgh University Press / MIT Press. Chapter 2 'Sound Change'.",
    "hock": "Hock, H. H. 1991. Principles of Historical Linguistics. 2nd ed. Mouton de Gruyter. Chapters 5-7.",
    "indexDiachronica": "Index Diachronica (ed. C. Mitchell): a catalogue of attested sound changes by language pair. https://chridd.nfshost.com/diachronica/ — the 'attested' field of each change names the section.",
    "kummel": "Kümmel, M. J. 2007. Konsonantenwandel. Reichert. (typology of consonant changes)"
  },
  "notation": {
    "rule": "TARGET > REPLACEMENT / ENVIRONMENT. Without '/ ENVIRONMENT' the change applies everywhere.",
    "segment": "An id of sounds.json, for example k or aː.",
    "sequence": "Units separated by spaces: 'a j' is a then j. TARGET and REPLACEMENT have the same number of units; unit n becomes unit n.",
    "set": "{a,b}: one of the members. A set in TARGET and a set in REPLACEMENT of the same size match by position. A member may be a sequence: {a j,a w}.",
    "features": "[...] a natural class by the fields of sounds.json: a bare value (stop, velar, close, front …) or +name / -name for a boolean (voice, lateral, long, nasal, rounded, aspirated, ejective, labialised, stress). [V ...] and [C ...] restrict to vowels or consonants.",
    "featureReplacement": "[...] in REPLACEMENT changes only the given fields and keeps the rest. The result must be a sound of sounds.json, or the change does not apply to that sound.",
    "alpha": "α, β: the same value in two places of one rule: [nasal place=α] / _[stop place=α].",
    "restrict": "X[...]: the unit X, only where it also has these features: {ɛ,ɔ}[+stress].",
    "index": "C₁ C₁: subscript numbers bind; two units with the same number are the same sound.",
    "zero": "∅: nothing. '∅ > e' inserts, 'e > ∅' deletes.",
    "environment": "_ is the place of TARGET. Class letters may stand together without spaces (VC_#). # a word edge, $ a syllable edge, … any material in the same word, (X) X or nothing, C₀ zero or more consonants.",
    "exception": "'// ENV' after the environment: the change does not apply there.",
    "choice": "A set in REPLACEMENT with no set of the same size at its place in TARGET ('∅ > {u,e}'): a language that takes the change uses one member, chosen once.",
    "classes": {
      "C": "[C]", "V": "[V]", "P": "[stop]", "A": "[affricate]", "F": "[fricative]", "N": "[nasal]",
      "L": "{l,ʎ,ɾ,r,ɹ}", "R": "{ɾ,r,ɹ}", "G": "{j,w}", "O": "[stop],[affricate],[fricative]", "S": "[nasal],L,G"
    },
    "stress": "[+stress] is the stressed vowel of a word, by the language's stress rule (inventories.json 'stress')."
  },
  "fields": {
    "family": "one of 'families' below",
    "requires": "classes or sounds that must be in the inventory, or the change has nothing to act on",
    "weight": "how often the change is drawn, relative; common changes (lenition, final losses) high",
    "example": "one attested example: the language pair, the older form, the younger form (as written in the sources, IPA in brackets where the spelling hides it)"
  },
  "families": [
    { "id": "lenition",      "text": "A consonant becomes weaker: a stop becomes a fricative or voiced, a fricative becomes h or goes.", "source": ["campbell", "kummel"] },
    { "id": "fortition",     "text": "A sound becomes stronger: a glide or fricative becomes a stop or an affricate.", "source": ["campbell", "kummel"] },
    { "id": "assimilation",  "text": "A sound becomes more similar to a sound next to it.", "source": ["campbell", "hock"] },
    { "id": "palatalization","text": "A consonant moves towards the palate before or after i, e or j.", "source": ["campbell", "hock"] },
    { "id": "dissimilation", "text": "A sound becomes less similar to a similar sound in the same word.", "source": ["campbell", "hock"] },
    { "id": "loss",          "text": "A sound goes from the word.", "source": ["campbell", "hock"] },
    { "id": "insertion",     "text": "A sound comes into the word.", "source": ["campbell", "hock"] },
    { "id": "metathesis",    "text": "Two sounds change places.", "source": ["campbell", "hock"] },
    { "id": "length",        "text": "A vowel becomes long or short.", "source": ["campbell", "hock"] },
    { "id": "vowelShift",    "text": "A vowel changes its quality: higher, lower, more to the front or to the back.", "source": ["campbell", "hock"] },
    { "id": "merger",        "text": "Two sounds become one sound.", "source": ["campbell", "hock"] }
  ],
  "changes": [
    { "id": "voicingIntervocalic", "family": "lenition", "rule": "[stop -voice -aspirated -ejective] > [+voice] / V_V", "requires": ["[stop +voice]"], "weight": 3,
      "text": "A voiceless stop between two vowels becomes voiced.", "attested": "Latin to Spanish", "example": ["Latin", "lupum", "Spanish", "lobo"] },
    { "id": "spirantizationIntervocalic", "family": "lenition", "rule": "{b,d,g} > {β,ð,ɣ} / V_V", "weight": 2,
      "text": "A voiced stop between two vowels becomes a fricative.", "attested": "Latin to Spanish", "example": ["Latin", "latus", "Spanish", "lado [ˈlaðo]"] },
    { "id": "grimmSpirantization", "family": "lenition", "rule": "{p,t,k} > {f,θ,x} // s_", "requires": ["F"], "weight": 1,
      "text": "A voiceless stop becomes a fricative, except after s.", "attested": "Proto-Indo-European to Proto-Germanic", "example": ["Proto-Indo-European", "*pṓds", "Proto-Germanic", "*fōts"] },
    { "id": "degemination", "family": "lenition", "rule": "C₁ C₁ > C₁ ∅", "weight": 2,
      "text": "Two equal consonants next to each other become one consonant.", "attested": "Latin to Spanish", "example": ["Latin", "gutta", "Spanish", "gota"] },
    { "id": "fricativeLossIntervocalic", "family": "lenition", "rule": "{ɣ,ð,β} > ∅ / V_V", "requires": ["{ɣ,ð,β}"], "weight": 1.5,
      "text": "A voiced fricative between two vowels goes.", "attested": "Latin to Spanish", "example": ["Latin", "legere", "Spanish", "leer"] },
    { "id": "sDebuccalizationInitial", "family": "lenition", "rule": "s > h / #_V", "requires": ["h"], "weight": 1,
      "text": "An s at the start of a word, before a vowel, becomes h.", "attested": "Proto-Indo-European to Ancient Greek", "example": ["Proto-Indo-European", "*septḿ̥", "Ancient Greek", "heptá"] },
    { "id": "sDebuccalizationCoda", "family": "lenition", "rule": "s > h / _{C,#}", "weight": 1,
      "text": "An s at the end of a syllable becomes h.", "attested": "Spanish to Andalusian Spanish", "example": ["Spanish", "estos", "Andalusian Spanish", "[ˈehtoh]"] },
    { "id": "hLoss", "family": "loss", "rule": "h > ∅", "requires": ["h"], "weight": 2,
      "text": "The sound h goes.", "attested": "Latin to Italian", "example": ["Latin", "habēre", "Italian", "avere"] },
    { "id": "finalDevoicing", "family": "assimilation", "rule": "[O +voice] > [-voice] / _#", "requires": ["[O +voice]"], "weight": 2,
      "text": "A voiced stop or fricative at the end of a word becomes voiceless.", "attested": "Middle High German to German", "example": ["German", "Hunde [ˈhʊndə]", "German", "Hund [hʊnt]"] },
    { "id": "velarPalatalization", "family": "palatalization", "rule": "k > tʃ / _[V front]", "weight": 2.5,
      "text": "A k before a front vowel becomes ch (tʃ).", "attested": "Latin to Italian", "example": ["Latin", "centum [ˈkentum]", "Italian", "cento [ˈtʃɛnto]"] },
    { "id": "velarPalatalizationVoiced", "family": "palatalization", "rule": "g > dʒ / _[V front]", "requires": ["g"], "weight": 2,
      "text": "A g before a front vowel becomes j (dʒ).", "attested": "Latin to Italian", "example": ["Latin", "gentem [ˈgentem]", "Italian", "gente [ˈdʒɛnte]"] },
    { "id": "velarPalatalizationSibilant", "family": "palatalization", "rule": "k > ts / _[V front]", "weight": 1,
      "text": "A k before a front vowel becomes ts.", "attested": "Latin to Old French", "example": ["Latin", "centum [ˈkentum]", "Old French", "cent [tsent]"] },
    { "id": "yodCoalescence", "family": "palatalization", "rule": "{t j,d j,s j} > {tʃ ∅,dʒ ∅,ʃ ∅}", "weight": 1.5,
      "text": "t, d or s before j joins with the j to become one palatal sound.", "attested": "Early Modern English to English", "example": ["Early Modern English", "nature [ˈneːtjʊr]", "English", "[ˈneɪtʃə]"] },
    { "id": "assibilationBeforeI", "family": "palatalization", "rule": "t > s / _i", "weight": 1.5,
      "text": "A t before i becomes s.", "attested": "Proto-Finnic to Finnish", "example": ["Proto-Finnic", "*käti", "Finnish", "käsi"] },
    { "id": "palatalNasal", "family": "palatalization", "rule": "n j > ɲ ∅", "weight": 1.5,
      "text": "n before j joins with the j to become ny (ɲ).", "attested": "Latin to Spanish", "example": ["Latin", "vinea", "Spanish", "viña"] },
    { "id": "palatalLateral", "family": "palatalization", "rule": "l j > ʎ ∅", "weight": 1,
      "text": "l before j joins with the j to become ly (ʎ).", "attested": "Latin to Italian", "example": ["Latin", "folia", "Italian", "foglia [ˈfɔʎʎa]"] },
    { "id": "initialClusterPalatal", "family": "palatalization", "rule": "[stop -voice] l > ʎ ∅ / #_", "weight": 0.5,
      "text": "A voiceless stop and l at the start of a word become ly (ʎ).", "attested": "Latin to Spanish", "example": ["Latin", "plēnum", "Spanish", "lleno"] },
    { "id": "nasalPlaceAssimilation", "family": "assimilation", "rule": "[nasal] > [place=α] / _[stop place=α]", "weight": 3,
      "text": "A nasal before a stop moves to the place of the stop.", "attested": "Latin (prefix in-)", "example": ["Latin", "in-possibilis", "Latin", "impossibilis"] },
    { "id": "voicingAssimilation", "family": "assimilation", "rule": "[O] > [voice=α] / _[O voice=α]", "weight": 2.5,
      "text": "A stop or fricative before another one takes its voicing.", "attested": "Latin", "example": ["Latin", "scrib- + -tus", "Latin", "scriptus"] },
    { "id": "stopClusterAssimilation", "family": "assimilation", "rule": "{k,p} > t / _t", "weight": 1.5,
      "text": "k or p before t becomes t.", "attested": "Latin to Italian", "example": ["Latin", "octō", "Italian", "otto"] },
    { "id": "intervocalicVoicingS", "family": "assimilation", "rule": "s > z / V_V", "requires": ["z"], "weight": 1.5,
      "text": "An s between two vowels becomes z.", "attested": "Latin to French", "example": ["Latin", "rosa [ˈrosa]", "French", "rose [ʁoz]"] },
    { "id": "rhotacism", "family": "assimilation", "rule": "{s,z} > r / V_V", "weight": 1,
      "text": "An s or z between two vowels becomes r.", "attested": "Old Latin to Latin", "example": ["Old Latin", "*flōsis", "Latin", "flōris"] },
    { "id": "umlaut", "family": "assimilation", "rule": "[V back] > [front] / _C₀{i,j}", "weight": 1,
      "text": "A back vowel moves to the front when i or j comes in the next syllable.", "attested": "Proto-Germanic to Old English", "example": ["Proto-Germanic", "*fōtiz", "Old English", "fēt"] },
    { "id": "vowelNasalization", "family": "assimilation", "rule": "V [nasal] > [+nasal] ∅ / _{C,#}", "requires": ["[V +nasal]"], "weight": 1,
      "text": "A vowel before a nasal at the end of a syllable becomes nasal, and the nasal goes.", "attested": "Latin to French", "example": ["Latin", "bonum", "French", "bon [bɔ̃]"] },
    { "id": "lVocalization", "family": "lenition", "rule": "l > w / V_C", "weight": 1,
      "text": "An l after a vowel and before a consonant becomes w.", "attested": "Latin to French", "example": ["Latin", "alterum", "French", "autre [otʁ]"] },
    { "id": "rhoticLoss", "family": "loss", "rule": "V R > [+long] ∅ / _{C,#}", "weight": 1,
      "text": "An r after a vowel and at the end of a syllable goes, and the vowel becomes long.", "attested": "English to Southern British English", "example": ["English", "car [kɑr]", "Southern British English", "[kɑː]"] },
    { "id": "tapping", "family": "lenition", "rule": "{t,d} > ɾ / [V +stress]_V", "requires": ["ɾ"], "weight": 0.7,
      "text": "A t or d after a stressed vowel and before a vowel becomes a tap (ɾ).", "attested": "English to American English", "example": ["English", "water [ˈwɔtər]", "American English", "[ˈwɑɾɚ]"] },
    { "id": "glottalReplacement", "family": "lenition", "rule": "t > ʔ / V_{#,C}", "requires": ["ʔ"], "weight": 0.7,
      "text": "A t at the end of a syllable becomes a glottal stop.", "attested": "English to London English", "example": ["English", "cat [kæt]", "London English", "[kæʔ]"] },
    { "id": "pToF", "family": "lenition", "rule": "p > ɸ", "weight": 1,
      "text": "The sound p becomes a fricative.", "attested": "Old Japanese to Middle Japanese", "example": ["Old Japanese", "*pana", "Middle Japanese", "fana [ɸana]"] },
    { "id": "fToH", "family": "lenition", "rule": "{ɸ,f} > h / #_V", "requires": ["h"], "weight": 1,
      "text": "An f at the start of a word becomes h.", "attested": "Latin to Old Spanish", "example": ["Latin", "facere", "Old Spanish", "hazer [haˈdzer]"] },
    { "id": "xToH", "family": "lenition", "rule": "x > h / #_", "requires": ["x"], "weight": 1,
      "text": "A kh (x) at the start of a word becomes h.", "attested": "Proto-Germanic to Old English", "example": ["Proto-Germanic", "*hundą [ˈxundɑ̃]", "Old English", "hund"] },
    { "id": "aspirateSpirantization", "family": "lenition", "rule": "[stop +aspirated] > [fricative -aspirated]", "requires": ["[+aspirated]"], "weight": 1,
      "text": "A stop with a breath after it becomes a fricative.", "attested": "Ancient Greek to Modern Greek", "example": ["Ancient Greek", "phílos [pʰílos]", "Modern Greek", "[ˈfilos]"] },
    { "id": "deaspiration", "family": "merger", "rule": "[+aspirated] > [-aspirated]", "requires": ["[+aspirated]"], "weight": 1,
      "text": "A stop loses the breath after it and becomes a plain stop.", "attested": "Proto-Indo-European to Proto-Slavic", "example": ["Proto-Indo-European", "*bʰréh₂tēr", "Old Church Slavonic", "bratrъ"] },
    { "id": "delabialization", "family": "merger", "rule": "[+labialised] > [-labialised]", "requires": ["[+labialised]"], "weight": 1,
      "text": "A kw becomes a plain k.", "attested": "Latin to Spanish", "example": ["Latin", "quid [kʷid]", "Spanish", "qué [ke]"] },
    { "id": "labiovelarToLabial", "family": "assimilation", "rule": "{kʷ,gʷ} > {p,b}", "requires": ["[+labialised]"], "weight": 0.7,
      "text": "A kw becomes p.", "attested": "Proto-Celtic to Welsh", "example": ["Proto-Indo-European", "*kʷetwóres", "Welsh", "pedwar"] },
    { "id": "uvularToGlottal", "family": "lenition", "rule": "q > ʔ", "requires": ["q"], "weight": 0.7,
      "text": "A q becomes a glottal stop.", "attested": "Arabic to Cairene Arabic", "example": ["Arabic", "qalb", "Cairene Arabic", "[ʔalb]"] },
    { "id": "betacism", "family": "lenition", "rule": "b > v", "requires": ["v"], "weight": 1,
      "text": "The sound b becomes v.", "attested": "Ancient Greek to Modern Greek", "example": ["Ancient Greek", "basileús", "Modern Greek", "[vasiˈlefs]"] },
    { "id": "wToV", "family": "fortition", "rule": "w > v / _V", "requires": ["v"], "weight": 1.5,
      "text": "A w before a vowel becomes v.", "attested": "Latin to Italian", "example": ["Latin", "vīnum [ˈwiːnum]", "Italian", "vino [ˈvino]"] },
    { "id": "wToGw", "family": "fortition", "rule": "∅ > g / #_w", "weight": 0.5,
      "text": "A w at the start of a word gets a g before it.", "attested": "Frankish to Old French", "example": ["Frankish", "*werra", "Old French", "guerre [ˈgwɛrrə]"] },
    { "id": "jToDj", "family": "fortition", "rule": "j > dʒ / #_", "weight": 1,
      "text": "A y (j) at the start of a word becomes j (dʒ).", "attested": "Latin to Italian", "example": ["Latin", "iocus [ˈjokus]", "Italian", "gioco [ˈdʒɔko]"] },
    { "id": "affrication", "family": "fortition", "rule": "t > ts / {#,C}_", "weight": 0.7,
      "text": "A t at the start of a word or after a consonant becomes ts.", "attested": "Proto-Germanic to Old High German", "example": ["Proto-Germanic", "*tehun", "German", "zehn [tseːn]"] },
    { "id": "thStopping", "family": "fortition", "rule": "{θ,ð} > {t,d}", "requires": ["{θ,ð}"], "weight": 1,
      "text": "A th (θ or ð) becomes t or d.", "attested": "Proto-Germanic to Dutch", "example": ["Proto-Germanic", "*þreiz [θreiz]", "Dutch", "drie"] },
    { "id": "thFronting", "family": "merger", "rule": "{θ,ð} > {f,v}", "requires": ["{θ,ð}"], "weight": 0.5,
      "text": "A th (θ or ð) becomes f or v.", "attested": "English to London English", "example": ["English", "think [θɪŋk]", "London English", "[fɪŋk]"] },
    { "id": "deaffrication", "family": "lenition", "rule": "{ts,dz} > {s,z}", "requires": ["{ts,dz}"], "weight": 1,
      "text": "An affricate ts or dz becomes s or z.", "attested": "Old French to French", "example": ["Old French", "cent [tsent]", "French", "[sɑ̃]"] },
    { "id": "deaffricationPalatal", "family": "lenition", "rule": "{tʃ,dʒ} > {ʃ,ʒ}", "requires": ["{tʃ,dʒ}"], "weight": 1,
      "text": "An affricate ch or j (tʃ, dʒ) becomes sh or zh.", "attested": "Old French to French", "example": ["Old French", "chanter [tʃanˈter]", "French", "[ʃɑ̃ˈte]"] },
    { "id": "sRetraction", "family": "assimilation", "rule": "s > ʃ / #_C", "requires": ["ʃ"], "weight": 0.7,
      "text": "An s at the start of a word, before a consonant, becomes sh.", "attested": "Middle High German to German", "example": ["Middle High German", "stein [stein]", "German", "Stein [ʃtaɪn]"] },
    { "id": "skToSh", "family": "palatalization", "rule": "s k > ʃ ∅", "requires": ["ʃ"], "weight": 0.7,
      "text": "The sounds s and k next to each other become sh.", "attested": "Proto-Germanic to Old English", "example": ["Proto-Germanic", "*skipą", "Old English", "scip [ʃip]"] },
    { "id": "gToJAfterVowel", "family": "lenition", "rule": "{g,ɣ} > j / [V front]_{C,#}", "weight": 0.7,
      "text": "A g after a front vowel, at the end of a syllable, becomes y (j).", "attested": "Old English to Middle English", "example": ["Old English", "dæg", "Middle English", "day [dæj]"] },
    { "id": "lToRInCluster", "family": "dissimilation", "rule": "l > ɾ / C_V", "requires": ["ɾ"], "weight": 0.5,
      "text": "An l after a consonant becomes r.", "attested": "Latin to Portuguese", "example": ["Latin", "placēre", "Portuguese", "prazer"] },
    { "id": "liquidDissimilation", "family": "dissimilation", "rule": "R > l / _…R", "requires": ["l"], "weight": 0.5,
      "text": "An r becomes l when another r comes later in the word.", "attested": "Latin to Italian", "example": ["Latin", "peregrīnus", "Italian", "pellegrino"] },
    { "id": "grassmannsLaw", "family": "dissimilation", "rule": "[+aspirated] > [-aspirated] / _V…[+aspirated]", "requires": ["[+aspirated]"], "weight": 0.3,
      "text": "A stop loses its breath when another stop with a breath comes later in the word.", "attested": "Proto-Indo-European to Ancient Greek", "example": ["Pre-Greek", "*tʰí-tʰēmi", "Ancient Greek", "títhēmi"] },
    { "id": "apocope", "family": "loss", "rule": "[V -stress] > ∅ / VC_#", "weight": 2.5,
      "text": "An unstressed vowel at the end of a word goes.", "attested": "Latin to Spanish", "example": ["Vulgar Latin", "pane", "Spanish", "pan"] },
    { "id": "schwaApocope", "family": "loss", "rule": "ə > ∅ / _#", "requires": ["ə"], "weight": 2,
      "text": "A weak vowel (ə) at the end of a word goes.", "attested": "Middle English to English", "example": ["Middle English", "name [ˈnaːmə]", "English", "[neɪm]"] },
    { "id": "syncope", "family": "loss", "rule": "[V -stress] > ∅ / VC_CV", "weight": 2,
      "text": "An unstressed vowel between two consonants inside a word goes.", "attested": "Latin to Italian", "example": ["Latin", "calidum", "Italian", "caldo"] },
    { "id": "aphaeresis", "family": "loss", "rule": "[V -stress] > ∅ / #_C", "weight": 1,
      "text": "An unstressed vowel at the start of a word goes.", "attested": "Latin to Old English", "example": ["Latin", "episcopus", "Old English", "biscop"] },
    { "id": "finalStopLoss", "family": "loss", "rule": "[stop] > ∅ / _#", "weight": 2,
      "text": "A stop at the end of a word goes.", "attested": "Latin to Italian", "example": ["Latin", "amat", "Italian", "ama"] },
    { "id": "finalNasalLoss", "family": "loss", "rule": "N > ∅ / V_#", "weight": 1.5,
      "text": "A nasal at the end of a word goes.", "attested": "Latin to Vulgar Latin", "example": ["Latin", "rosam", "Vulgar Latin", "rosa"] },
    { "id": "finalSLoss", "family": "loss", "rule": "s > ∅ / _#", "weight": 1.5,
      "text": "An s at the end of a word goes.", "attested": "Latin to Italian", "example": ["Latin", "tres", "Italian", "tre"] },
    { "id": "clusterSimplification", "family": "loss", "rule": "C > ∅ / C_C", "weight": 2,
      "text": "The middle consonant of three consonants goes.", "attested": "Middle English to English", "example": ["Middle English", "Cristmasse", "English", "Christmas [ˈkrɪsməs]"] },
    { "id": "initialClusterReduction", "family": "loss", "rule": "{k,g} > ∅ / #_N", "weight": 1,
      "text": "A k or g before a nasal at the start of a word goes.", "attested": "Middle English to English", "example": ["Middle English", "knee [kneː]", "English", "[niː]"] },
    { "id": "compensatoryLengthening", "family": "length", "rule": "V {x,s,h} > [+long] ∅ / _C", "requires": ["[+long]"], "weight": 1.5,
      "text": "A fricative before a consonant goes, and the vowel before it becomes long.", "attested": "Old French to French", "example": ["Old French", "beste", "French", "bête [bɛːt]"] },
    { "id": "closedSyllableShortening", "family": "length", "rule": "[V +long] > [-long] / _CC", "requires": ["[+long]"], "weight": 1,
      "text": "A long vowel before two consonants becomes short.", "attested": "Old English to Middle English", "example": ["Old English", "cēpte", "Middle English", "kepte"] },
    { "id": "openSyllableLengthening", "family": "length", "rule": "[V +stress -long] > [+long] / _CV", "weight": 1,
      "text": "A stressed short vowel in an open syllable becomes long.", "attested": "Old English to Middle English", "example": ["Old English", "nama [ˈnama]", "Middle English", "name [ˈnaːmə]"] },
    { "id": "lengthLoss", "family": "merger", "rule": "[V +long] > [-long]", "requires": ["[+long]"], "weight": 1,
      "text": "Long vowels become short, and long and short vowels become the same.", "attested": "Latin to Vulgar Latin", "example": ["Latin", "lūna [ˈluːna]", "Italian", "luna [ˈluna]"] },
    { "id": "longVowelRaising", "family": "vowelShift", "rule": "{eː,oː} > {iː,uː}", "requires": ["[+long]"], "weight": 1,
      "text": "A long mid vowel moves up and becomes a long high vowel.", "attested": "Middle English to English (Great Vowel Shift)", "example": ["Middle English", "fet [feːt]", "English", "feet [fiːt]"] },
    { "id": "highVowelDiphthongization", "family": "vowelShift", "rule": "{iː,uː} > {a j,a w}", "requires": ["[+long]"], "weight": 0.7,
      "text": "A long high vowel becomes a vowel and a glide (ay or aw).", "attested": "Middle English to English (Great Vowel Shift)", "example": ["Middle English", "hous [huːs]", "English", "house [haʊs]"] },
    { "id": "breaking", "family": "vowelShift", "rule": "{ɛ,ɔ}[+stress] > {j e,w e}", "weight": 1,
      "text": "A stressed open e or o becomes ye or we.", "attested": "Latin to Spanish", "example": ["Latin", "petra", "Spanish", "piedra"] },
    { "id": "monophthongization", "family": "vowelShift", "rule": "{a j,a w} > {e ∅,o ∅}", "weight": 1.5,
      "text": "A vowel and a glide (ay or aw) become one vowel.", "attested": "Latin to Spanish", "example": ["Latin", "aurum", "Spanish", "oro"] },
    { "id": "uFronting", "family": "vowelShift", "rule": "u > y", "requires": ["y"], "weight": 0.5,
      "text": "The vowel u moves to the front and becomes ü (y).", "attested": "Latin to French", "example": ["Latin", "lūna", "French", "lune [lyn]"] },
    { "id": "longARaising", "family": "vowelShift", "rule": "aː > ɛː", "requires": ["aː"], "weight": 0.5,
      "text": "A long a moves up and to the front.", "attested": "Proto-Greek to Attic Greek", "example": ["Doric Greek", "mā́tēr", "Attic Greek", "mḗtēr"] },
    { "id": "longABacking", "family": "vowelShift", "rule": "aː > ɔː", "requires": ["aː"], "weight": 0.5,
      "text": "A long a moves to the back and becomes a long open o.", "attested": "Old English to Middle English", "example": ["Old English", "stān", "Middle English", "stoon [stɔːn]"] },
    { "id": "laxVowelLowering", "family": "merger", "rule": "{ɪ,ʊ} > {e,o}", "requires": ["{ɪ,ʊ}"], "weight": 1,
      "text": "A short high vowel moves down and becomes e or o.", "attested": "Latin to Vulgar Latin", "example": ["Latin", "pilum [ˈpɪlʊ]", "Italian", "pelo"] },
    { "id": "vowelReduction", "family": "merger", "rule": "[V -stress] > ə", "requires": ["ə"], "weight": 1.5,
      "text": "An unstressed vowel becomes a weak vowel (ə).", "attested": "Old English to Middle English", "example": ["Old English", "sunu", "Middle English", "sune [ˈsunə]"] },
    { "id": "glideFormation", "family": "vowelShift", "rule": "{i,e}[-stress] > j / _V", "weight": 1,
      "text": "An unstressed i or e before another vowel becomes y (j).", "attested": "Latin to Vulgar Latin", "example": ["Latin", "vinea [ˈwinea]", "Vulgar Latin", "*vinja"] },
    { "id": "prothesis", "family": "insertion", "rule": "∅ > e / #_s C", "weight": 1,
      "text": "A vowel comes before s and a consonant at the start of a word.", "attested": "Latin to Spanish", "example": ["Latin", "scala", "Spanish", "escala"] },
    { "id": "anaptyxis", "family": "insertion", "rule": "∅ > u / C_l", "weight": 0.7,
      "text": "A vowel comes between a consonant and l.", "attested": "Old Latin to Latin", "example": ["Old Latin", "pōclom", "Latin", "pōculum"] },
    { "id": "stopEpenthesis", "family": "insertion", "rule": "∅ > [stop +voice place=α] / [nasal place=α]_L", "weight": 0.7,
      "text": "A stop comes between a nasal and r or l.", "attested": "Old English to English", "example": ["Old English", "þunor", "English", "thunder"] },
    { "id": "paragoge", "family": "insertion", "rule": "∅ > {u,e} / C_#", "weight": 0.7,
      "text": "A vowel comes after a consonant at the end of a word.", "attested": "English loanwords in Japanese", "example": ["English", "bus", "Japanese", "basu"] },
    { "id": "liquidMetathesis", "family": "metathesis", "rule": "V L > L V / C_C", "weight": 0.7,
      "text": "A vowel and r or l between two consonants change places.", "attested": "Proto-Slavic to Old Church Slavonic", "example": ["Proto-Slavic", "*gordъ", "Old Church Slavonic", "gradъ"] },
    { "id": "rMetathesis", "family": "metathesis", "rule": "R V > V R / C_C", "weight": 0.5,
      "text": "An r and the vowel after it change places.", "attested": "Old English to English", "example": ["Old English", "brid", "English", "bird"] }
  ]
}
